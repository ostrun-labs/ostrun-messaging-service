{
  "provider": "Ostrun",
  "service": "notification",
  "version": "0.1.0",
  "displayName": "Ostrun Notification",
  "description": "Ostrun reference notification service: sends emails triggered by other services' events (e.g. user registration).",
  "repository": "https://github.com/ostrun-labs/ostrun-notification-service",
  "registry": null,
  "needsDb": true,
  "events": {
    "published": [
      "Ostrun.Notification.EmailSent"
    ],
    "consumed": [
      "Ostrun.Auth.UserRegistered"
    ]
  },
  "dependencies": ["ostrun/auth"],
  "env": [
    {
      "name": "ASPNETCORE_URLS",
      "required": true,
      "description": "Kestrel listen URL(s), e.g. http://+:8080"
    },
    {
      "name": "ConnectionStrings__Notification",
      "required": true,
      "description": "PostgreSQL connection string (Npgsql)"
    },
    {
      "name": "Smtp__Host",
      "required": true,
      "description": "SMTP server host used for sending"
    },
    {
      "name": "Smtp__Port",
      "required": false,
      "default": "587",
      "description": "SMTP port"
    },
    {
      "name": "Smtp__Username",
      "required": false,
      "description": "SMTP username, if authentication is required"
    },
    {
      "name": "Smtp__Password",
      "required": false,
      "description": "SMTP password, if authentication is required"
    },
    {
      "name": "Smtp__UseStartTls",
      "required": false,
      "default": "true",
      "description": "Enables STARTTLS"
    },
    {
      "name": "Smtp__FromAddress",
      "required": true,
      "description": "Sender address for emails"
    },
    {
      "name": "Smtp__FromName",
      "required": false,
      "default": "Ostrun",
      "description": "Displayed sender name"
    },
    {
      "name": "RabbitMq__Host",
      "required": false,
      "description": "RabbitMQ host. If absent, events use the in-memory transport (no broker required standalone)"
    },
    {
      "name": "RabbitMq__VirtualHost",
      "required": false,
      "description": "RabbitMQ virtual host (default: /)"
    },
    {
      "name": "RabbitMq__Username",
      "required": false,
      "description": "RabbitMQ username (default: guest)"
    },
    {
      "name": "RabbitMq__Password",
      "required": false,
      "description": "RabbitMQ password (default: guest)"
    }
  ],
  "ports": [
    {
      "containerPort": 8080,
      "protocol": "http",
      "description": "HTTP API"
    }
  ],
  "healthCheck": {
    "path": "/health",
    "method": "GET"
  }
}
