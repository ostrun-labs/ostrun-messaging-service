# Postgres (used by both the "postgres" and "api" services in docker-compose.yml)
POSTGRES_USER=ostrun_notification
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ostrun_notification

# Api
ASPNETCORE_URLS=http://+:8080

# SMTP. Defaults target the Mailpit container from docker-compose.yml.
# Point this at a real relay outside local development.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=no-reply@ostrun.dev
SMTP_FROM_NAME=Ostrun
